#!/usr/bin/env bash
# Mac-side CLI for per-project remote dev environments. Every remote action is
# one SSH call to projects/host/projects-host on the box.
set -euo pipefail

HOST=${PROJECTS_HOST:-vince-archive}
REMOTE='$HOME/vinceworks/projects/host/projects-host'
LOCAL_PROJECTS=${PROJECTS_LOCAL:-$HOME/projects}

usage() {
  cat <<USAGE
usage: projects <command|name> [args]

  projects <name> [session]             attach to a project's tmux session (default: main)
  projects new <owner/repo> [name]      clone, allocate a port, build, start, attach
  projects ls
  projects stop <name>
  projects rm <name> [--purge]
  projects rebuild [name]
  projects secrets <name> <relpath>...  copy files from $LOCAL_PROJECTS/<name> to the host, then restart
  projects open <name>                  open the project's URL in the browser
  projects sync                         git pull vinceworks on the host
USAGE
  exit 1
}

remote() { ssh "$HOST" "$REMOTE $*"; }
remote_tty() { ssh -t "$HOST" "$REMOTE $*"; }

cmd_secrets() {
  local name=${1:?name required}
  shift
  [[ $# -gt 0 ]] || usage
  for rel in "$@"; do
    local src="$LOCAL_PROJECTS/$name/$rel"
    [[ -f "$src" ]] || { echo "  [error] $src not found" >&2; exit 1; }
    ssh "$HOST" "mkdir -p ~/.projects/$name/secrets/$(dirname "$rel")"
    scp -q "$src" "$HOST:.projects/$name/secrets/$rel"
    echo "  [copied] $rel"
  done
  remote restart "$name"
}

cmd_open() {
  local name=${1:?name required} port
  port=$(remote port "$name")
  open "http://$HOST:$port"
}

command=${1:-}
[[ -n "$command" ]] || usage
shift
case "$command" in
  new) remote_tty new "$@"; name=$(basename "${1:?}" .git); remote_tty attach "${2:-$name}" ;;
  ls|stop|rm|rebuild|start|restart|build) remote_tty "$command" "$@" ;;
  secrets) cmd_secrets "$@" ;;
  open) cmd_open "$@" ;;
  sync) ssh "$HOST" 'git -C ~/vinceworks pull --ff-only' ;;
  -h|--help|help) usage ;;
  *) remote_tty attach "$command" "$@" ;;
esac
