#!/usr/bin/env bash
# Runs in the sandbox and on the Mac. The single entry point a worktree tool calls
# after creating a worktree: fast-forwards it to origin/main, copies untracked
# secrets from the source checkout, then allocates a PORT. Reads no PASEO_* vars.
# Reports every action on stdout, so a worktree tool's UI shows what it did.
set -euo pipefail

worktree=${1:?usage: checkout-setup <worktree> [source-checkout]}
[[ -d "$worktree" ]] || { echo "checkout-setup: $worktree is not a directory" >&2; exit 1; }

source_checkout=${2:-}
if [[ -z "$source_checkout" ]]; then
  source_checkout=$(git -C "$worktree" worktree list --porcelain | sed -n "1s/^worktree //p")
  [[ -n "$source_checkout" && -d "$source_checkout" ]] \
    || { echo "checkout-setup: could not determine source checkout for $worktree" >&2; exit 1; }
fi

head_commit=$(git -C "$worktree" rev-parse HEAD)
echo "checkout-setup: fetching origin/main"
git -C "$worktree" fetch --quiet origin main
main_commit=$(git -C "$worktree" rev-parse FETCH_HEAD)

if git -C "$worktree" merge-base --is-ancestor "$main_commit" "$head_commit"; then
  echo "  worktree already contains origin/main"
elif git -C "$worktree" merge-base --is-ancestor "$head_commit" "$main_commit"; then
  git -C "$worktree" merge --ff-only --quiet "$main_commit"
  echo "  fast-forwarded from ${head_commit:0:7} to ${main_commit:0:7}"
else
  echo "checkout-setup: refusing to update: worktree has diverged from origin/main" >&2
  exit 1
fi

if [[ "$worktree" -ef "$source_checkout" ]]; then
  echo "checkout-setup: $worktree is its own source checkout, copying nothing"
else
  echo "checkout-setup: copying secrets from $source_checkout"
  secrets=(.env config/master.key)
  while IFS= read -r -d '' key; do
    secrets+=("${key#"$source_checkout"/}")
  done < <(find "$source_checkout/config/credentials" -maxdepth 1 -name '*.key' -print0 2>/dev/null)

  reported=0
  for rel in "${secrets[@]}"; do
    src="$source_checkout/$rel"
    dest="$worktree/$rel"
    [[ -f "$src" ]] || continue
    if [[ -e "$dest" ]]; then
      echo "  kept $rel already in the worktree"   # never overwrite
      reported=$((reported + 1))
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    cp "$src" "$dest"
    echo "  copied $rel"
    reported=$((reported + 1))
  done
  (( reported )) || echo "  no secrets found in the source checkout"
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
notices=$(mktemp)
trap 'rm -f "$notices"' EXIT
if ! port=$("$script_dir/alloc-port" "$worktree" 2>"$notices"); then
  cat "$notices" >&2
  exit 1
fi
[[ -s "$notices" ]] && sed 's/^/  /' "$notices"
echo "checkout-setup: PORT=$port in $worktree/.env"
