#!/usr/bin/env bash
# Mac-side CLI for per-project agent SSH access to production boxes. keygen
# generates a scoped ed25519 keypair in the sandbox and prints what's needed
# to wire it up by hand; see agent-ssh-access-plan.md for the full design.
set -euo pipefail

SSH_HOST=${SANDBOX_SSH_HOST:-vinceworks-sandbox}
BOT_USER=vinceworks-bot
SSH_DIR=$(cd "$(dirname "$(realpath "$0")")" && pwd)

usage() {
  cat <<USAGE
usage: vinceworks ssh <command> [args]

  vinceworks ssh keygen <project> <host> [--resume]   generate a scoped keypair in the sandbox for <project> on <host>, then walk through the manual production setup steps
                                                        --resume skips generation and replays the walkthrough for a key that already exists
USAGE
  exit 1
}

# Walks through 9 paced steps: reveal the public key and authorized_keys
# line, then the manual production setup steps. Shared by both the
# fresh-generation and --resume paths in cmd_keygen, which must set
# project, host, tag, pubkey, key_type and key_data before calling this.
print_keygen_walkthrough() {
  local authorized_keys_line="restrict,command=\"rrsync -ro /\" $key_type $key_data $tag"
  # Double quotes escaped for step 3 below, where the line is embedded inside
  # an outer double-quoted ssh command - unescaped quotes there would close
  # that string early and break the pasted command.
  local authorized_keys_line_escaped=${authorized_keys_line//\"/\\\"}

  echo "1. Here's the public key for $tag:"
  echo "$pubkey"
  read -rp "Press Enter to continue... "

  echo
  echo "2. Here's the authorized_keys line for $BOT_USER on $host (tagged for revoke)."
  echo "   This is the line sshd checks when this key tries to log in - restrict,command=\"rrsync -ro /\" forces every connection using this key into a read-only rsync no matter what command is actually sent; the tag on the end is just a label for later revoke, not functional to SSH:"
  echo "$authorized_keys_line"
  read -rp "Press Enter to continue... "

  echo
  echo "== next steps (run these yourself - nothing below is automated) =="
  echo
  echo "3. Copy ssh/provision-bot-user.sh to the box for $tag."
  echo "   Replace <ssh-target> below with wherever that box actually is for you (hostname, IP, or your own ssh config alias) - \"$host\" is just this key's label, not assumed to be reachable:"
  echo "     scp $SSH_DIR/provision-bot-user.sh <ssh-target>:~/provision-bot-user.sh"
  read -rp "Press Enter once that's done... "

  echo
  echo "4. SSH to <ssh-target>:"
  echo "     ssh <ssh-target>"
  read -rp "Press Enter once that's done... "

  echo
  echo "5. Run the script as root, in that same session (it deletes itself once it succeeds):"
  echo "     sudo bash ~/provision-bot-user.sh"
  read -rp "Press Enter once that's done... "

  echo
  echo "6. Append the authorized_keys line to $BOT_USER's file on $host. Run this from your Mac (same <ssh-target> as above) - don't paste the raw line anywhere yourself, this command does the appending for you:"
  echo "     ssh <ssh-target> \"echo '$authorized_keys_line_escaped' | sudo tee -a /home/$BOT_USER/.ssh/authorized_keys\""
  read -rp "Press Enter once that's done... "

  echo
  echo "7. On $host, check rrsync is on $BOT_USER's PATH:"
  echo "     sudo -u $BOT_USER which rrsync"
  echo "   If that prints nothing, find it (it ships with rsync but usually isn't linked onto PATH) and install it:"
  echo "     sudo find / -iname 'rrsync*' 2>/dev/null"
  echo "     sudo install -m 755 <path found above> /usr/local/bin/rrsync"
  read -rp "Press Enter once rrsync resolves for $BOT_USER... "

  echo
  echo "8. On $host, confirm sshd has a Match block for $BOT_USER with LogLevel VERBOSE."
  read -rp "Press Enter once you've confirmed this... "

  echo
  echo "9. On $host, confirm $BOT_USER cannot read secrets anywhere it has access to (.env files, credential files, other projects' config, etc, wherever they live on this box)."
  read -rp "Press Enter once you've confirmed this... "

  echo
  echo "$tag should now be live on $host."
}

cmd_keygen() {
  local project=${1:?project required} host=${2:?host required}
  shift 2
  local resume=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --resume) resume=true; shift ;;
      *) echo "  [error] unknown argument: $1" >&2; exit 1 ;;
    esac
  done

  local key_name="$project-$host"
  local tag="vinceworks:$project:$host"
  local pubkey key_type key_data

  if $resume; then
    if ! ssh "$SSH_HOST" "[ -e ~/.ssh/vinceworks-bot/$(printf %q "$key_name") ]"; then
      echo "  [error] ~/.ssh/vinceworks-bot/$key_name doesn't exist in the sandbox; run keygen without --resume first" >&2
      exit 1
    fi
    pubkey=$(ssh "$SSH_HOST" "cat ~/.ssh/vinceworks-bot/$(printf %q "$key_name").pub")
  else
    # Refuse rather than touch an existing key, so a re-run never clobbers one in use.
    if ssh "$SSH_HOST" "[ -e ~/.ssh/vinceworks-bot/$(printf %q "$key_name") ]"; then
      echo "  [error] ~/.ssh/vinceworks-bot/$key_name already exists in the sandbox; refusing to overwrite" >&2
      exit 1
    fi

    ssh "$SSH_HOST" "mkdir -p -m 700 ~/.ssh/vinceworks-bot && ssh-keygen -t ed25519 -N '' -C $(printf %q "$tag") -f ~/.ssh/vinceworks-bot/$(printf %q "$key_name") -q"
    pubkey=$(ssh "$SSH_HOST" "cat ~/.ssh/vinceworks-bot/$(printf %q "$key_name").pub")
  fi

  read -r key_type key_data _ <<<"$pubkey"

  print_keygen_walkthrough
}

command=${1:-}
[[ -n "$command" ]] || usage
shift

case "$command" in
  keygen) cmd_keygen "$@" ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
