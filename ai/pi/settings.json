{
  "lastChangelogVersion": "0.85.1",
  "theme": "tokyo-night",
  "hideThinkingBlock": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-6-astra",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/deepseek-v4-flash-vision-exp",
    "opencode-go/deepseek-v4-pro"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "extensions": [
    "~/vinceworks/ai/pi/extensions/context-footer.ts"
  ],
  "themes": [
    "~/vinceworks/ai/pi/themes"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": { "thinking": "low" },
      "delegate": { "thinking": "low" },
      "researcher": { "thinking": "medium" },
      "worker": { "thinking": "high" },
      "reviewer": { "thinking": "high" },
      "evidence-auditor": { "thinking": "high" },
      "oracle": { "thinking": "high" }
    },
    "agentOverridesByProvider": {
      "openai-codex": {
        "scout": { "model": "openai-codex/gpt-5.6-luna" },
        "delegate": { "model": "openai-codex/gpt-5.6-luna" },
        "researcher": { "model": "openai-codex/gpt-5.6-luna" },
        "worker": { "model": "openai-codex/gpt-5.6-terra" },
        "reviewer": { "model": "openai-codex/gpt-5.6-terra" },
        "evidence-auditor": { "model": "openai-codex/gpt-5.6-terra" },
        "oracle": { "model": "openai-codex/gpt-5.6-sol" }
      },
      "opencode-go": {
        "scout": { "model": "opencode-go/deepseek-v4.1-flash" },
        "delegate": { "model": "opencode-go/deepseek-v4.1-flash" },
        "researcher": { "model": "opencode-go/deepseek-v4.1-flash" },
        "worker": { "model": "opencode-go/deepseek-v4.1-flash" },
        "reviewer": { "model": "opencode-go/deepseek-v4.1-flash" },
        "evidence-auditor": { "model": "opencode-go/deepseek-v4.1-flash" },
        "oracle": { "model": "opencode-go/deepseek-v4-pro" }
      }
    }
  }
}
