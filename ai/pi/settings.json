{
  "lastChangelogVersion": "0.85.1",
  "theme": "tokyo-night",
  "hideThinkingBlock": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "enabledModels": [
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-astra",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/deepseek-v4-flash-vision-exp",
    "opencode-go/deepseek-v4-pro"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "extensions": [
    "~/vinceworks/ai/pi/extensions/context-footer.ts"
  ],
  "themes": [
    "~/vinceworks/ai/pi/themes"
  ],
  "subagents": {
    "agentOverridesByProvider": {
      "openai-codex": {
        "scout": { "model": "openai-codex/gpt-6-luna", "thinking": "medium" },
        "delegate": { "model": "openai-codex/gpt-6-luna", "thinking": "medium" },
        "researcher": { "model": "openai-codex/gpt-6-luna", "thinking": "high" },
        "worker": { "model": "openai-codex/gpt-6-luna", "thinking": "max" },
        "reviewer": { "model": "openai-codex/gpt-6-sol", "thinking": "xhigh" },
        "evidence-auditor": { "model": "openai-codex/gpt-6-sol", "thinking": "xhigh" },
        "oracle": { "model": "openai-codex/gpt-6-sol", "thinking": "max" }
      },
      "opencode-go": {
        "scout": { "model": "opencode-go/deepseek-v4.1-flash", "thinking": "low" },
        "delegate": { "model": "opencode-go/deepseek-v4.1-flash", "thinking": "low" },
        "researcher": { "model": "opencode-go/deepseek-v4.1-flash", "thinking": "medium" },
        "worker": { "model": "opencode-go/deepseek-v4.1-flash", "thinking": "high" },
        "reviewer": { "model": "opencode-go/deepseek-v4-pro", "thinking": "high" },
        "evidence-auditor": { "model": "opencode-go/deepseek-v4.1-flash", "thinking": "high" },
        "oracle": { "model": "opencode-go/deepseek-v4-pro", "thinking": "xhigh" }
      }
    }
  }
}
