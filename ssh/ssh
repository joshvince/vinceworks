#!/usr/bin/env bash
# Mac-side CLI for per-project agent SSH access to production boxes. keygen
# generates a scoped ed25519 keypair in the sandbox and prints what's needed
# to wire it up by hand; see agent-ssh-access-plan.md for the full design.
set -euo pipefail

SSH_HOST=${SANDBOX_SSH_HOST:-vinceworks-sandbox}
BOT_USER=vinceworks-bot
SSH_DIR=$(cd "$(dirname "$(realpath "$0")")" && pwd)

usage() {
  cat <<USAGE
usage: vinceworks ssh <command> [args]

  vinceworks ssh keygen <project> <host> [--resume]   generate a scoped keypair in the sandbox for <project> on <host>, then walk through the manual production setup steps
                                                        --resume skips generation and replays the walkthrough for a key that already exists
USAGE
  exit 1
}

# Walks through 12 paced steps: reveal the public key and authorized_keys
# line, the manual production setup steps, then an end-to-end read/write
# test. Shared by both the fresh-generation and --resume paths in
# cmd_keygen, which must set project, host, tag, pubkey, key_type,
# key_data and key_name before calling this.
print_keygen_walkthrough() {
  local authorized_keys_line="restrict,command=\"rrsync -ro /\" $key_type $key_data $tag"
  # Double quotes escaped for step 3 below, where the line is embedded inside
  # an outer double-quoted ssh command - unescaped quotes there would close
  # that string early and break the pasted command.
  local authorized_keys_line_escaped=${authorized_keys_line//\"/\\\"}

  local bold=$'\033[1m' italic=$'\033[3m' cyan=$'\033[36m' reset=$'\033[0m'
  local rule="────────────────────────────────────────"

  step() { echo; echo "$rule"; echo "${bold}$1${reset}"; echo; }
  note() { echo "${italic}$1${reset}"; }
  prompt() { echo; read -rp "${cyan}$1${reset}"; }

  step "1. 🔑  Public key for $tag"
  echo "$pubkey"
  prompt "Press Enter to continue... "

  step "2. 🔐  authorized_keys line for $BOT_USER on $host (tagged for revoke)"
  note "This is the line sshd checks when this key tries to log in - restrict,command=\"rrsync -ro /\" forces every connection using this key into a read-only rsync no matter what command is actually sent; the tag on the end is just a label for later revoke, not functional to SSH:"
  echo
  echo "$authorized_keys_line"
  prompt "Press Enter to continue... "

  echo
  echo "${bold}== next steps (run these yourself - nothing below is automated) ==${reset}"

  step "3. 📤  Copy ssh/provision-bot-user.sh to the box for $tag"
  note "Replace <ssh-target> below with wherever that box actually is for you (hostname, IP, or your own ssh config alias) - \"$host\" is just this key's label, not assumed to be reachable:"
  echo
  echo "  scp $SSH_DIR/provision-bot-user.sh <ssh-target>:~/provision-bot-user.sh"
  prompt "Press Enter once that's done... "

  step "4. 🔗  SSH to <ssh-target>"
  echo "  ssh <ssh-target>"
  prompt "Press Enter once that's done... "

  step "5. ⚙️   Run the script as root, in that same session (it deletes itself once it succeeds)"
  echo "  sudo bash ~/provision-bot-user.sh"
  prompt "Press Enter once that's done... "

  step "6. ➕  Append the authorized_keys line to $BOT_USER's file on $host"
  note "Run this from your Mac (same <ssh-target> as above) - don't paste the raw line anywhere yourself, this command does the appending for you:"
  echo
  echo "  ssh <ssh-target> \"echo '$authorized_keys_line_escaped' | sudo tee -a /home/$BOT_USER/.ssh/authorized_keys\""
  prompt "Press Enter once that's done... "

  step "7. 🔍  Check rrsync is on $BOT_USER's PATH, on $host"
  echo "  sudo -u $BOT_USER which rrsync"
  echo
  note "If that prints nothing, find it (it ships with rsync but usually isn't linked onto PATH) and install it:"
  echo
  echo "  sudo find / -iname 'rrsync*' 2>/dev/null"
  echo
  echo "  sudo install -m 755 <path found above> /usr/local/bin/rrsync"
  prompt "Press Enter once rrsync resolves for $BOT_USER... "

  step "8. 📝  Add an sshd Match block for $BOT_USER with LogLevel VERBOSE, on $host"
  echo "  sudo tee /etc/ssh/sshd_config.d/$BOT_USER.conf <<'CONF'"
  echo "Match User $BOT_USER"
  echo "    LogLevel VERBOSE"
  echo "CONF"
  echo
  echo "  sudo sshd -t && sudo systemctl reload sshd"
  echo
  note "Verify it's applied:"
  echo
  echo "  sudo sshd -T -C user=$BOT_USER | grep -i loglevel"
  prompt "Press Enter once that's applied... "

  step "9. 🔒  Confirm $BOT_USER can't read secrets anywhere it has access to, on $host"
  note "(.env files, credential files, other projects' config, etc, wherever they live on this box)"
  prompt "Press Enter once you've confirmed this... "

  step "10. 🧪  SSH to the sandbox to test the key end to end"
  echo "  ssh $SSH_HOST"
  prompt "Press Enter once that's done... "

  step "11. 📥  Test read access, in that same sandbox session"
  note "Replace <ssh-target> with the same box as before. This should succeed and print a hostname:"
  echo
  echo "  rsync -e \"ssh -i ~/.ssh/vinceworks-bot/$key_name\" $BOT_USER@<ssh-target>:/etc/hostname /tmp/ && cat /tmp/hostname"
  prompt "Press Enter once that's succeeded... "

  step "12. 🚫  Test that writing is blocked, in that same sandbox session"
  note "This should be refused - if it succeeds instead, the forced command isn't restricting writes and needs fixing before this key is trusted:"
  echo
  echo "  echo test > /tmp/vinceworks-write-test.txt"
  echo
  echo "  rsync -e \"ssh -i ~/.ssh/vinceworks-bot/$key_name\" /tmp/vinceworks-write-test.txt $BOT_USER@<ssh-target>:/tmp/"
  prompt "Press Enter once that's confirmed refused... "

  echo
  echo "$rule"
  echo "${bold}✅  $tag should now be live on $host.${reset}"
}

cmd_keygen() {
  local project=${1:?project required} host=${2:?host required}
  shift 2
  local resume=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --resume) resume=true; shift ;;
      *) echo "  [error] unknown argument: $1" >&2; exit 1 ;;
    esac
  done

  local key_name="$project-$host"
  local tag="vinceworks:$project:$host"
  local pubkey key_type key_data

  if $resume; then
    if ! ssh "$SSH_HOST" "[ -e ~/.ssh/vinceworks-bot/$(printf %q "$key_name") ]"; then
      echo "  [error] ~/.ssh/vinceworks-bot/$key_name doesn't exist in the sandbox; run keygen without --resume first" >&2
      exit 1
    fi
    pubkey=$(ssh "$SSH_HOST" "cat ~/.ssh/vinceworks-bot/$(printf %q "$key_name").pub")
  else
    # Refuse rather than touch an existing key, so a re-run never clobbers one in use.
    if ssh "$SSH_HOST" "[ -e ~/.ssh/vinceworks-bot/$(printf %q "$key_name") ]"; then
      echo "  [error] ~/.ssh/vinceworks-bot/$key_name already exists in the sandbox; refusing to overwrite" >&2
      exit 1
    fi

    ssh "$SSH_HOST" "mkdir -p -m 700 ~/.ssh/vinceworks-bot && ssh-keygen -t ed25519 -N '' -C $(printf %q "$tag") -f ~/.ssh/vinceworks-bot/$(printf %q "$key_name") -q"
    pubkey=$(ssh "$SSH_HOST" "cat ~/.ssh/vinceworks-bot/$(printf %q "$key_name").pub")
  fi

  read -r key_type key_data _ <<<"$pubkey"

  print_keygen_walkthrough
}

command=${1:-}
[[ -n "$command" ]] || usage
shift

case "$command" in
  keygen) cmd_keygen "$@" ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
